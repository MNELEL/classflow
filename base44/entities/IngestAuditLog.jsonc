{
  "name": "IngestAuditLog",
  "type": "object",
  "properties": {
    "file_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e7\u05d5\u05d1\u05e5 \u05e9\u05e2\u05d5\u05d1\u05d3"
    },
    "suggested_category": {
      "type": "string",
      "description": "\u05d4\u05e1\u05d9\u05d5\u05d5\u05d2/\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 \u05e9\u05d4-AI \u05d4\u05e6\u05d9\u05e2"
    },
    "final_category": {
      "type": "string",
      "description": "\u05d4\u05e1\u05d9\u05d5\u05d5\u05d2 \u05e9\u05e0\u05e9\u05de\u05e8 \u05d1\u05e4\u05d5\u05e2\u05dc"
    },
    "confidence": {
      "type": "string",
      "description": "\u05e8\u05de\u05ea \u05d1\u05d9\u05d8\u05d7\u05d5\u05df \u05d4-AI (high/medium/low)"
    },
    "material_type": {
      "type": "string",
      "enum": [
        "study",
        "exam",
        "prep"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d7\u05d5\u05de\u05e8"
    },
    "was_changed": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e9\u05d9\u05e0\u05d4 \u05d0\u05ea \u05d4\u05e1\u05d9\u05d5\u05d5\u05d2/\u05d8\u05e7\u05e1\u05d8 \u05dc\u05e4\u05e0\u05d9 \u05d4\u05e9\u05de\u05d9\u05e8\u05d4"
    },
    "original_text_length": {
      "type": "number",
      "description": "\u05d0\u05d5\u05e8\u05da \u05d4\u05d8\u05e7\u05e1\u05d8 \u05e9\u05d7\u05d5\u05dc\u05e5"
    },
    "item_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4-LibraryItem \u05d0\u05dd \u05e0\u05e9\u05de\u05e8"
    }
  },
  "required": [
    "file_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}