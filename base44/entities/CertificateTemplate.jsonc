{
  "name": "CertificateTemplate",
  "properties": {
    "accent_color": {
      "description": "\u05e6\u05d1\u05e2 \u05e8\u05d0\u05e9\u05d9 \u05de\u05d6\u05d5\u05d4\u05d4 \u05d1\u05ea\u05de\u05d5\u05e0\u05d4 (HEX)",
      "type": "string"
    },
    "analyzed_layout": {
      "description": "\u05ea\u05d5\u05e6\u05d0\u05ea \u05e0\u05d9\u05ea\u05d5\u05d7 \u05d4-AI: \u05e6\u05d1\u05e2\u05d9\u05dd, \u05de\u05d9\u05e7\u05d5\u05dd \u05dc\u05d5\u05d2\u05d5/\u05db\u05d5\u05ea\u05e8\u05ea/\u05d7\u05ea\u05d9\u05de\u05d4, \u05e0\u05d5\u05e1\u05d7 \u05de\u05d3\u05d5\u05d9\u05e7 \u05e9\u05d6\u05d5\u05d4\u05d4, \u05e1\u05d2\u05e0\u05d5\u05df \u05de\u05e1\u05d2\u05e8\u05ea/\u05e2\u05d9\u05d8\u05d5\u05e8\u05d9\u05dd, \u05d5\u05db\u05df \u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8 design \u05e2\u05dd \u05d8\u05d5\u05e7\u05e0\u05d9\u05dd \u05de\u05d5\u05d1\u05e0\u05d9\u05dd \u05dc\u05d4\u05d7\u05dc\u05ea \u05e2\u05d9\u05e6\u05d5\u05d1 \u05d3\u05d5\u05de\u05d4",
      "type": "object"
    },
    "design": {
      "description": "\u05d8\u05d5\u05e7\u05e0\u05d9\u05dd \u05e2\u05d9\u05e6\u05d5\u05d1\u05d9\u05d9\u05dd \u05de\u05d5\u05d1\u05e0\u05d9\u05dd \u05e9\u05d7\u05d5\u05dc\u05e6\u05d5 \u05de\u05d4\u05ea\u05d1\u05e0\u05d9\u05ea (\u05e6\u05d1\u05e2\u05d9\u05dd, \u05de\u05e1\u05d2\u05e8\u05ea, \u05d2\u05d5\u05e4\u05df, \u05e2\u05d9\u05d8\u05d5\u05e8\u05d9\u05dd, \u05e1\u05d9\u05de\u05df \u05de\u05d9\u05dd) \u05dc\u05d4\u05d7\u05dc\u05ea \u05e2\u05d9\u05e6\u05d5\u05d1 \u05d3\u05d5\u05de\u05d4 \u05e2\u05dc \u05de\u05e1\u05de\u05db\u05d9\u05dd \u05d7\u05d3\u05e9\u05d9\u05dd",
      "type": "object",
      "properties": {
        "accent_color": {
          "type": "string"
        },
        "secondary_color": {
          "type": "string"
        },
        "background_color": {
          "type": "string"
        },
        "frame_style": {
          "type": "string",
          "enum": [
            "double",
            "single",
            "ornate",
            "none"
          ]
        },
        "frame_color": {
          "type": "string"
        },
        "corner_decoration": {
          "type": "string",
          "enum": [
            "none",
            "floral",
            "stars",
            "geometric"
          ]
        },
        "title_font": {
          "type": "string",
          "enum": [
            "serif",
            "sans",
            "decorative"
          ]
        },
        "title_align": {
          "type": "string",
          "enum": [
            "center",
            "right"
          ]
        },
        "icon_symbol": {
          "type": "string"
        },
        "has_watermark": {
          "type": "boolean"
        },
        "watermark_text": {
          "type": "string"
        },
        "layout_density": {
          "type": "string",
          "enum": [
            "airy",
            "compact"
          ]
        }
      }
    },
    "detected_body_text": {
      "description": "\u05e0\u05d5\u05e1\u05d7 \u05d4\u05d1\u05e8\u05db\u05d4/\u05d2\u05d5\u05e3 \u05d4\u05d8\u05e7\u05e1\u05d8 \u05d4\u05de\u05d3\u05d5\u05d9\u05e7 \u05db\u05e4\u05d9 \u05e9\u05d6\u05d5\u05d4\u05d4 \u05d1\u05ea\u05de\u05d5\u05e0\u05d4",
      "type": "string"
    },
    "detected_subjects": {
      "description": "\u05de\u05e7\u05e6\u05d5\u05e2\u05d5\u05ea/\u05ea\u05d7\u05d5\u05de\u05d9\u05dd \u05e9\u05d6\u05d5\u05d5\u05d7\u05d5 \u05d1\u05ea\u05de\u05d5\u05e0\u05d4 (\u05dc\u05ea\u05e2\u05d5\u05d3\u05d5\u05ea \u05d1\u05dc\u05d1\u05d3)",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "detected_title": {
      "description": "\u05db\u05d5\u05ea\u05e8\u05ea \u05de\u05d3\u05d5\u05d9\u05e7\u05ea \u05db\u05e4\u05d9 \u05e9\u05d6\u05d5\u05d4\u05ea\u05d4 \u05d1\u05ea\u05de\u05d5\u05e0\u05d4",
      "type": "string"
    },
    "is_active": {
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05ea\u05d1\u05e0\u05d9\u05ea \u05e4\u05e2\u05d9\u05dc\u05d4 \u05dc\u05e9\u05d9\u05de\u05d5\u05e9",
      "type": "boolean"
    },
    "kind": {
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05ea\u05d1\u05e0\u05d9\u05ea",
      "enum": [
        "certificate",
        "weekly_bulletin"
      ],
      "type": "string"
    },
    "library_item_id": {
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4-LibraryItem \u05e9\u05de\u05e0\u05d5 \u05e0\u05d5\u05ea\u05d7\u05d4 \u05d4\u05ea\u05d1\u05e0\u05d9\u05ea (\u05ea\u05de\u05d5\u05e0\u05ea \u05d4\u05ea\u05e2\u05d5\u05d3\u05d4 \u05d4\u05de\u05e7\u05d5\u05e8\u05d9\u05ea)",
      "type": "string"
    },
    "name": {
      "description": "\u05e9\u05dd \u05d9\u05d3\u05d9\u05d3\u05d5\u05ea\u05d9 \u05dc\u05ea\u05d1\u05e0\u05d9\u05ea (\u05dc\u05de\u05e9\u05dc: \u05ea\u05e2\u05d5\u05d3\u05ea \u05de\u05d7\u05e6\u05d9\u05ea)",
      "type": "string"
    },
    "status": {
      "default": "pending",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05e0\u05d9\u05ea\u05d5\u05d7 \u05d4-AI",
      "enum": [
        "pending",
        "analyzing",
        "ready",
        "error"
      ],
      "type": "string"
    }
  },
  "required": [
    "library_item_id",
    "kind"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}