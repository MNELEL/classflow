{
  "name": "TeacherSecurity",
  "type": "object",
  "properties": {
    "uid": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e9\u05dc \u05d4\u05de\u05d5\u05e8\u05d4"
    },
    "pin_enabled": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05e0\u05e2\u05d9\u05dc\u05ea PIN \u05de\u05d5\u05e4\u05e2\u05dc\u05ea"
    },
    "pin_hash": {
      "type": "string",
      "description": "Hash \u05e9\u05dc \u05d4-PIN (HMAC-SHA256, \u05dc\u05e2\u05d5\u05dc\u05dd \u05dc\u05d0 \u05d8\u05e7\u05e1\u05d8 \u05d2\u05dc\u05d5\u05d9)"
    },
    "pin_salt": {
      "type": "string",
      "description": "Salt \u05e8\u05e0\u05d3\u05d5\u05de\u05dc\u05d9 per-user (32 \u05d1\u05ea\u05d9\u05dd, base64url) \u2014 \u05e0\u05d5\u05e6\u05e8 \u05d1-set_pin \u05d5\u05de\u05e9\u05d5\u05dc\u05d1 \u05d1\u05de\u05e4\u05ea\u05d7 \u05d4-HMAC \u05d9\u05d7\u05d3 \u05e2\u05dd BASE44_APP_ID"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "failed_attempts": {
      "type": "integer",
      "default": 0,
      "description": "\u05de\u05e1\u05e4\u05e8 \u05e0\u05d9\u05e1\u05d9\u05d5\u05e0\u05d5\u05ea \u05db\u05d5\u05e9\u05dc\u05d9\u05dd \u05e8\u05e6\u05d5\u05e4\u05d9\u05dd \u05dc\u05d4\u05d6\u05e0\u05ea PIN \u2014 \u05de\u05ea\u05d0\u05e4\u05e1 \u05e2\u05dd \u05d4\u05e6\u05dc\u05d7\u05d4"
    },
    "locked_until": {
      "type": "string",
      "format": "date-time",
      "description": "\u05d0\u05dd \u05de\u05d5\u05d2\u05d3\u05e8, \u05d1\u05d3\u05d9\u05e7\u05ea PIN \u05d7\u05e1\u05d5\u05de\u05d4 \u05e2\u05d3 \u05dc\u05de\u05d5\u05e2\u05d3 \u05d6\u05d4 \u05e2\u05e7\u05d1 \u05e0\u05d9\u05e1\u05d9\u05d5\u05e0\u05d5\u05ea \u05e9\u05d2\u05d5\u05d9\u05d9\u05dd \u05de\u05e8\u05d5\u05d1\u05d9\u05dd"
    },
    "link_teacher_failed_attempts": {
      "type": "integer",
      "default": 0,
      "description": "\u05de\u05e1\u05e4\u05e8 \u05e0\u05d9\u05e1\u05d9\u05d5\u05e0\u05d5\u05ea \u05db\u05d5\u05e9\u05dc\u05d9\u05dd \u05e8\u05e6\u05d5\u05e4\u05d9\u05dd \u05e9\u05dc \u05de\u05e9\u05ea\u05de\u05e9 \u05d6\u05d4 \u05dc\u05e7\u05e9\u05d5\u05e8 \u05de\u05d5\u05e8\u05d4 \u05d1\u05d0\u05de\u05e6\u05e2\u05d5\u05ea \u05e7\u05d5\u05d3 \u05d2\u05d9\u05e9\u05d4 (linkTeacher function) \u2014 \u05de\u05ea\u05d0\u05e4\u05e1 \u05e2\u05dd \u05d4\u05e6\u05dc\u05d7\u05d4"
    },
    "link_teacher_locked_until": {
      "type": "string",
      "format": "date-time",
      "description": "\u05d0\u05dd \u05de\u05d5\u05d2\u05d3\u05e8, \u05d4\u05e0\u05d9\u05e1\u05d9\u05d5\u05e0\u05d5\u05ea \u05dc\u05e7\u05e9\u05d5\u05e8 \u05de\u05d5\u05e8\u05d4 \u05d3\u05e8\u05da access_code \u05d7\u05e1\u05d5\u05de\u05d9\u05dd \u05e2\u05d1\u05d5\u05e8 \u05de\u05e9\u05ea\u05de\u05e9 \u05d6\u05d4 \u05e2\u05d3 \u05dc\u05de\u05d5\u05e2\u05d3 \u05d6\u05d4"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d0\u05d5\u05e4\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9 \u2014 \u05d4\u05e2\u05e8\u05d4 \u05d7\u05d5\u05e4\u05e9\u05d9\u05ea"
    }
  },
  "required": [
    "uid",
    "pin_enabled"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}