{
  "name": "ContactEntry",
  "properties": {
    "category": {
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d9\u05ea \u05d0\u05d9\u05e9 \u05d4\u05e7\u05e9\u05e8",
      "enum": [
        "\u05d4\u05e0\u05d4\u05dc\u05d4 \u05d5\u05e6\u05d5\u05d5\u05ea",
        "\u05e1\u05e4\u05e7\u05d9\u05dd \u05d5\u05e9\u05d9\u05e8\u05d5\u05ea\u05d9\u05dd",
        "\u05d1\u05e8\u05d9\u05d0\u05d5\u05ea \u05d5\u05d7\u05d9\u05e8\u05d5\u05dd",
        "\u05d4\u05d5\u05e8\u05d9\u05dd \u05d5\u05e7\u05d4\u05d9\u05dc\u05d4"
      ],
      "type": "string"
    },
    "class_id": {
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05db\u05d9\u05ea\u05d4 (\u05e8\u05d9\u05e7 = \u05d3\u05e3 \u05e7\u05e9\u05e8 \u05db\u05dc\u05dc\u05d9 \u05dc\u05de\u05d5\u05e1\u05d3)",
      "type": "string"
    },
    "email": {
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc",
      "type": "string"
    },
    "name": {
      "description": "\u05e9\u05dd",
      "type": "string"
    },
    "notes": {
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea",
      "type": "string"
    },
    "phone": {
      "description": "\u05d8\u05dc\u05e4\u05d5\u05df",
      "type": "string"
    },
    "role": {
      "description": "\u05ea\u05e4\u05e7\u05d9\u05d3",
      "type": "string"
    },
    "sort_order": {
      "default": 0,
      "description": "\u05e1\u05d3\u05e8 \u05ea\u05e6\u05d5\u05d2\u05d4",
      "type": "number"
    }
  },
  "required": [
    "category",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}